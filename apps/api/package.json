{
  "name": "@runline/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "db"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "bullmq": "6.7.8",
    "cookie": "^1.1.1",
    "express": "^5.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.18",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6"
  }
}
