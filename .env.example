# defaults for local development. use unique passwords on a vps.
RUNLINE_DB_PASSWORD=runline_local_owner
RUNLINE_APP_PASSWORD=runline_local_app
RUNLINE_DOCUMENTS_PASSWORD=runline_local_documents
RUNLINE_S3_ACCESS_KEY=runline_local
RUNLINE_S3_SECRET_KEY=runline_local_storage_secret
RUNLINE_DEMO_MODE=true
RUNLINE_WEB_PORT=3000

# set a random secret of at least 32 bytes to keep sessions and customer links across api restarts.
RUNLINE_SESSION_SECRET=
# set to true when serving the site over https.
RUNLINE_SECURE_COOKIE=false
